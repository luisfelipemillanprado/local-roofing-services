# Amazon SES — contact form email delivery (server-only)
# The form works in dev without these; fill them to activate real sending.
AWS_REGION=us-east-1
SES_FROM=quotes@yourdomain.com
CONTACT_TO=leads@yourdomain.com

# AWS credentials resolve via the standard chain (env vars or an IAM role):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
